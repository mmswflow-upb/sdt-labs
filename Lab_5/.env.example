# ===========================================
# SDT Lab 5 - Microservices Environment Variables
# ===========================================
# Copy this file to .env and adjust the values as needed
# Usage: cp .env.example .env

# ===========================================
# Eureka Service Discovery Configuration
# ===========================================
EUREKA_PORT=8761
EUREKA_SERVER_URL=http://eureka-server:${EUREKA_PORT}/eureka/
EUREKA_SELF_PRESERVATION=false
EUREKA_EVICTION_INTERVAL=5000
EUREKA_CACHE_UPDATE_INTERVAL=5000

# ===========================================
# API Gateway Configuration
# ===========================================
API_GATEWAY_PORT=8080

# ===========================================
# Database Configuration - Student Service
# ===========================================
STUDENT_DB_NAME=studentdb
STUDENT_DB_USER=student
STUDENT_DB_PASSWORD=student
STUDENT_DB_PORT=5433

# ===========================================
# Database Configuration - Professor Service
# ===========================================
PROFESSOR_DB_NAME=professordb
PROFESSOR_DB_USER=professor
PROFESSOR_DB_PASSWORD=professor
PROFESSOR_DB_PORT=5434

# ===========================================
# Database Configuration - Course Service
# ===========================================
COURSE_DB_NAME=coursedb
COURSE_DB_USER=course
COURSE_DB_PASSWORD=course
COURSE_DB_PORT=5435

# ===========================================
# Database Configuration - Grading Service
# ===========================================
GRADING_DB_NAME=gradingdb
GRADING_DB_USER=grading
GRADING_DB_PASSWORD=grading
GRADING_DB_PORT=5436

# ===========================================
# Service Ports
# ===========================================
STUDENT_SERVICE_PORT=8081
PROFESSOR_SERVICE_PORT=8082
COURSE_SERVICE_PORT=8083
GRADING_SERVICE_PORT=8084

# ===========================================
# Service URLs (for inter-service communication)
# ===========================================
STUDENT_SERVICE_URL=http://student-service:8080
PROFESSOR_SERVICE_URL=http://professor-service:8080
COURSE_SERVICE_URL=http://course-service:8080
GRADING_SERVICE_URL=http://grading-service:8080

# ===========================================
# JPA Configuration
# ===========================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
